# 复制为 .env 后按内网实际情况填写

# 数据库
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/talent_graph

# 内部大模型平台（内网 API，OpenAI 兼容协议）
LLM_BASE_URL=http://internal-llm-platform.local/v1
LLM_API_KEY=your-internal-key
LLM_MODEL=your-model-name
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# Embedding：填了走内部平台接口；留空则本地加载 BGE-M3（需 GPU + sentence-transformers）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 注意：平台模型名需带前缀（如 SiliconFlow 为 BAAI/bge-m3），不能只写 bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_LOCAL_PATH=BAAI/bge-m3

# 文件存储
UPLOAD_DIR=./data/uploads

# 匹配参数
MATCH_VECTOR_TOP_K=30
MATCH_FINAL_TOP_N=10
